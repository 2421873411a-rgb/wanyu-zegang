# 皖域择岗 API 环境配置示例

# 应用配置
APP_NAME=皖域择岗 API
# APP_VERSION 不需手填：默认从 wan-api/release.json（wanyu-api-release/v1）单一真源读取；
# 部署布局由 deploy.sh 注入。手工填写会破坏版本单一真源。
DEBUG=false

# 数据库配置
DATABASE_URL=postgresql+asyncpg://wanyu_user:your_password@localhost:5432/wanyu_db
DATABASE_ECHO=false

# Redis配置
REDIS_URL=redis://localhost:6379/0

# JWT配置
# 必填！生成方式：openssl rand -hex 32（至少 32 字符，公开/默认值会导致拒启——
# v17.9.12 门禁：任何正式环境缺失/公开默认值/弱密钥都不允许启动）
SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS配置
CORS_ORIGINS=["https://wan.kaogong.art","http://localhost:8765"]

# 限流后端：memory（默认，单 worker）| redis（多 worker 必须）
RATE_LIMIT_BACKEND=memory

# 静态数据路径（用于数据导入）
STATIC_DATA_PATH=/opt/wanyu/static/maintainable/data

# 注册配置
ALLOW_REGISTRATION=true
ADMIN_EMAIL=admin@kaogong.art

# 分页配置
DEFAULT_PAGE_SIZE=60
MAX_PAGE_SIZE=200
