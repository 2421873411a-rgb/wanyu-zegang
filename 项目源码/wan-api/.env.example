# 皖域择岗 API 环境配置示例

# 应用配置
APP_NAME=皖域择岗 API
APP_VERSION=1.0.0
DEBUG=false

# 数据库配置
DATABASE_URL=postgresql+asyncpg://wanyu_user:your_password@localhost:5432/wanyu_db
DATABASE_ECHO=false

# Redis配置
REDIS_URL=redis://localhost:6379/0

# JWT配置
SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS配置
CORS_ORIGINS=["https://wan.kaogong.art","http://localhost:8765"]

# 静态数据路径（用于数据导入）
STATIC_DATA_PATH=/opt/wanyu/static/maintainable/data

# 注册配置
ALLOW_REGISTRATION=true
ADMIN_EMAIL=admin@kaogong.art

# 分页配置
DEFAULT_PAGE_SIZE=60
MAX_PAGE_SIZE=200
